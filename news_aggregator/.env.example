# ============================================================
#  Healthcare VC News Aggregator — Configuration
#  Copy to .env and fill in your values.
# ============================================================

# ----------------------------------------------------------
# Anthropic (Claude) — required
# ----------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ----------------------------------------------------------
# Gmail — reuse from daily_summary if already set up.
# These point to the shared credentials in ../daily_summary/
# Override here if you want separate credentials.
# ----------------------------------------------------------
SUMMARY_FROM_EMAIL=you@gmail.com
SUMMARY_TO_EMAIL=you@gmail.com
GMAIL_CREDENTIALS_FILE=../daily_summary/credentials.json
GMAIL_TOKEN_FILE=../daily_summary/token.json

# ----------------------------------------------------------
# NewsAPI (optional but recommended — free tier available)
# Sign up at https://newsapi.org/ — 100 req/day on free plan
# ----------------------------------------------------------
NEWSAPI_KEY=

# ----------------------------------------------------------
# Crunchbase (optional — requires paid API access)
# Sign up at https://data.crunchbase.com/docs
# Provides the richest funding round data.
# ----------------------------------------------------------
CRUNCHBASE_API_KEY=

# ----------------------------------------------------------
# How many hours back to look for news (default: 24)
# Increase to 48 on Mondays to catch weekend news.
# ----------------------------------------------------------
LOOKBACK_HOURS=24

# ----------------------------------------------------------
# Timezone
# ----------------------------------------------------------
TIMEZONE=America/New_York

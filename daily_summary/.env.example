# ============================================================
#  Daily Summary Bot — Configuration
#  Copy this file to .env and fill in your values.
# ============================================================

# ----------------------------------------------------------
# Anthropic (Claude) — required for summarization
# Get your key at: https://console.anthropic.com/
# ----------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ----------------------------------------------------------
# Gmail — required
# SUMMARY_FROM_EMAIL : your Gmail address (used to read mail and send the digest)
# SUMMARY_TO_EMAIL   : where to deliver the digest (can be the same address)
# GMAIL_CREDENTIALS_FILE : path to the OAuth client secret JSON you download
#                          from Google Cloud Console (see README)
# GMAIL_TOKEN_FILE   : where to cache the OAuth access token (auto-created)
# ----------------------------------------------------------
SUMMARY_FROM_EMAIL=you@gmail.com
SUMMARY_TO_EMAIL=you@gmail.com
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# ----------------------------------------------------------
# Slack — optional but recommended
# Create a Slack App at https://api.slack.com/apps
# Add USER TOKEN SCOPES (not bot scopes):
#   channels:history  channels:read
#   groups:history    groups:read
#   im:history        im:read
#   mpim:history      mpim:read
#   users:read
# Then install to your workspace and copy the "User OAuth Token" (xoxp-...)
# Leave blank to skip Slack (email-only digest).
# ----------------------------------------------------------
SLACK_USER_TOKEN=xoxp-...

# ----------------------------------------------------------
# Timezone — adjust if you're not on Eastern Time
# Common values: America/New_York, America/Chicago,
#                America/Denver, America/Los_Angeles
# ----------------------------------------------------------
TIMEZONE=America/New_York
